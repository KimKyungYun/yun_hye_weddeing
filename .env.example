# 이 파일을 .env (또는 .env.local) 로 복사해서 값을 채운다. 둘 다 있으면 .env.local 이 우선한다.
# .env · .env.local 은 커밋되지 않는다. 값은 채팅·코드에 붙여 넣지 않는다.
# 배포할 때는 Vercel → Project → Settings → Environment Variables 에 같은 이름으로 넣는다.

# ── Supabase (관리자 로그인) ─────────────────────────────────────
# Project Settings → Data API → Project URL
#   https://<project-ref>.supabase.co  (뒤에 /rest/v1/ 이 붙어 있어도 도메인만 쓴다)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_...)
#   NEXT_PUBLIC_ 값은 브라우저에 그대로 노출된다. Secret key(sb_secret_...)·service_role 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 데이터베이스 (Prisma) ────────────────────────────────────────
# 대시보드 상단 Connect → ORMs → Prisma 에 두 줄이 나온다.
#   - [YOUR-PASSWORD] 를 대괄호까지 지우고 DB 비밀번호로 바꾼다.
#   - 비밀번호의 특수문자는 URL 인코딩한다 (@ → %40, # → %23, / → %2F, ? → %3F, % → %25, : → %3A).
#   - 비밀번호를 모르면 Project Settings → Database → Reset database password.
# 앱 실행용: Transaction pooler (6543)
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# 마이그레이션용: Session pooler (5432)
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ── 관리자 ───────────────────────────────────────────────────────
# 관리자 화면(/admin)에 들어올 수 있는 이메일. 신랑·신부 둘 다 쓰려면 쉼표로 구분한다.
#   예) groom@example.com,bride@example.com
# 같은 이메일로 Authentication → Users → Add user 에서 계정을 만든다(비밀번호는 Supabase 만 안다).
ADMIN_EMAILS=

# ── 사이트 ───────────────────────────────────────────────────────
# OG 이미지(카카오톡 미리보기)의 절대 주소 기준. 로컬은 그대로 둔다.
# Vercel 에서는 비워 두거나 localhost 그대로여도 운영 도메인(xxx.vercel.app · 연결한 도메인)을 알아서 쓴다.
# 다른 주소로 공유하고 싶을 때만 Vercel 환경변수에 https://… 로 넣는다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 카카오 지도 · 카카오톡 공유 (선택) ──────────────────────────
# developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키. 지도와 공유가 같은 키를 쓴다.
# 같은 화면의 플랫폼 → Web 에 사이트 도메인(로컬은 http://localhost:3000, 배포 도메인도)을 등록해야 열린다.
# 비워 두면 오시는 길에 카카오 지도가 빠지고(지도 앱 버튼만 남는다), "카카오톡 공유하기"는 휴대폰 공유창·링크 복사로 대신한다.
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
